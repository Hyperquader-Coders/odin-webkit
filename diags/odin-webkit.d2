# odin-webkit: its place in the binding graph
# Render:  d2 diags/odin-webkit.d2 diags/odin-webkit.svg

direction: down

title: "odin-webkit" {
  shape: text
  near: top-center
  style.font-size: 28
  style.bold: true
}

this: "odin-webkit\nWebKitGTK 6.0 and JavaScriptCore 2.52.6" {
  style.fill: "#eef6ff"
}
lib: "webkitgtk-6.0 (shared library)" {
  style.fill: "#fff6e6"
}
consumers: "every other binding and every app\nimport \"webkit:<pkg>\"" {
  style.fill: "#f2f2f2"
}

consumers -> this: collection webkit
this -> lib: foreign import
